# ---- Saksham environment ----
# true shows the "Try the demo" panel, sandbox OTP codes and demo labels. MUST be false in production.
DEMO_MODE=true
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public origin of the site (used for passkeys and CSRF checks)
APP_ORIGIN=http://localhost:3000

# Claude API (server only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Supabase (optional in development; required in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS provider for OTP (required when DEMO_MODE=false). Example: Sparrow SMS
SMS_PROVIDER=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Owner/admin accounts: your 10-digit mobile number(s), comma-separated. These get the Admin page.
OWNER_PHONES=

# Support contact shown on /contact (leave empty to hide)
SUPPORT_EMAIL=
SUPPORT_PHONE=

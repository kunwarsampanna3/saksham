# ---- Saksham environment ----
# true shows the "Try the demo" panel, sandbox OTP codes and demo labels. MUST be false in production.
DEMO_MODE=true
# One password for the whole site (12+ characters). Required on Render while DEMO_MODE=true; leave empty on your laptop.
SITE_PASSWORD=
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Only if your proxy OVERWRITES this header with the visitor's IP (not merely appends to it). Empty = trust none.
TRUSTED_IP_HEADER=
# Automatic selfie match: on | off. Empty = on, except on Render (it needs ~700 MB; off = admin reviews selfies).
FACE_MATCH=
# Public origin of the site (used for passkeys and CSRF checks)
APP_ORIGIN=http://localhost:3000

# Claude API (server only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Supabase (optional in development; required in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS provider for OTP (required when DEMO_MODE=false). Example: Sparrow SMS
SMS_PROVIDER=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Owner/admin accounts: your 10-digit mobile number(s), comma-separated. These get the Admin page.
OWNER_PHONES=

# Support contact shown on /contact (leave empty to hide)
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Email for sign-in codes (sign up / sign in / forgot MPIN with an email address).
# Leave empty in demo mode to show the code on screen instead. Choose ONE option:
#  A) Gmail (or any mailbox): turn on 2-Step Verification, create an App password at
#     https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (no spaces).
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#  B) Resend (https://resend.com): an API key and a verified sending domain
RESEND_API_KEY=
